# Copie para .env (servidor local) ou cadastre nas variáveis da hospedagem. Nunca no frontend nem no git.

# E-mail do administrador da mesa: gerencia convites e papéis. Ser administrador não dá acesso às fichas dos outros.
TABLE_OWNER_EMAIL=mestre@local

# Código de acesso do administrador no modo mesa (npm run mesa / npm start). Obrigatório nesse modo, com pelo
# menos 12 letras ou números. Gere um com: npm run codigo. Trocar o código derruba as sessões antigas dele.
# MESA_CODIGO_ADMIN=

# Como jogadores e mestre entram no modo mesa (o administrador entra sempre com o código acima):
#   codigo (padrão) → cada pessoa com o seu link de acesso, um código que vale como senha;
#   email           → só com o e-mail cadastrado na mesa, sem código. Quem souber o e-mail entra como a pessoa.
# MESA_LOGIN=email

# Endereço e porta. Padrões: modo dev ouve só em 127.0.0.1; modo mesa ouve em 0.0.0.0 (rede/hospedagem).
# A hospedagem costuma definir PORT sozinha.
# HOST=0.0.0.0
# PORT=8787

# Onde ficam o banco (local.db) e os backups das fichas, e onde estão as páginas renderizadas dos livros.
# Na hospedagem, aponte os dois para o volume persistente (ex.: /data e /data/books).
# DATA_DIR=data
# BOOKS_DIR=books/rendered
